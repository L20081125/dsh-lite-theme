{
  "name": "dsh-lite-theme",
  "version": "0.1.0",
  "description": "动漫美化主题插件：10 套二次元主题（毛玻璃质感）+ 壁纸 + 炫技动效 + 主题工坊 + 主题包，支持 dsh Web / 桌面端",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "themes/",
    "wallpapers/",
    "templates/",
    "scripts/",
    "docs/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
